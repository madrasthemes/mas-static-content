    "core/navigation",
    "core/navigation-submenu"
  ],
  "attributes": {
    "staticContentId": {
      "type": "integer"
    }
  },
  "supports": {
    "inserter": true,
    "html": false
  },
  "textdomain": "mas-static-content",
  "editorScript": "file:./index.js"
}