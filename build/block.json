{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "mas-static-content/navigation-static-content",
  "title": "MegaMenu",
  "category": "widgets",
  "icon": "screenoptions",
  "description": "Displays a static content inside the navigation menu.",
